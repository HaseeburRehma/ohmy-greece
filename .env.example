# Copy to .env.local (dev) or set in your hosting dashboard. Never commit real values.

# Public URL of the site (used for logo/links inside emails)
SITE_URL=https://www.ohmygreece.de

# Team inbox that receives new franchise applications
MAIL_TO=info@ohmygreece.de
# Sender shown in both emails (domain must be verified with the provider)
EMAIL_FROM="Oh My Greece <franchise@ohmygreece.de>"

# Pick ONE provider. With neither set, dev logs emails to the console and
# production answers 503 (the form then shows its fallback message).
# Option A: Resend
RESEND_API_KEY=
# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Set at build time to expose /email-preview in a production build (staging only)
EMAIL_PREVIEW=
